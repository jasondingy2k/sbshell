{
  "http_clients": [{"tag": "rule-set-direct"}],
  "dns": {
    "servers": [
      {"tag": "local", "type": "udp", "server": "223.5.5.5"},
      {"tag": "public", "type": "https", "server": "dns.alidns.com", "domain_resolver": "local"},
      {"tag": "foreign", "type": "https", "server": "dns.google", "domain_resolver": "local"},
      {"tag": "fakeip", "type": "fakeip", "inet4_range": "198.18.0.0/15", "inet6_range": "fc00::/18"}
    ],
    "rules": [
      {"clash_mode": "direct", "server": "local"},
      {"clash_mode": "global", "server": "foreign"},
      {"rule_set": ["geosite-cn", "geosite-apple"], "server": "local"},
      {"query_type": ["A", "AAAA"], "server": "fakeip", "rewrite_ttl": 1}
    ],
    "final": "public",
    "strategy": "prefer_ipv4"
  },
  "outbounds": [
    {"tag": "🚀 默认代理", "type": "selector", "outbounds": ["🌐 全部节点", "🇺🇸 美国节点", "🇰🇷 韩国节点", "🕹️ 手动选择", "➡️ 直连"]},
    {"tag": "🕹️ 手动选择", "type": "selector", "outbounds": ["{all}"], "filter": [{"action": "exclude", "keywords": ["TCP", "TLS"]}]},
    {"tag": "🇺🇸 美国节点", "type": "selector", "outbounds": ["{all}"], "filter": [{"action": "include", "keywords": ["racknerd", "bwg"]}, {"action": "exclude", "keywords": ["TCP", "TLS"]}]},
    {"tag": "🇰🇷 韩国节点", "type": "selector", "outbounds": ["{all}"], "filter": [{"action": "include", "keywords": ["amdcc"]}, {"action": "exclude", "keywords": ["TCP", "TLS"]}]},
    {"tag": "🧠 AI", "type": "selector", "outbounds": ["🚀 默认代理", "🇺🇸 美国节点", "🇰🇷 韩国节点", "🕹️ 手动选择", "➡️ 直连"]},
    {"tag": "💬 Reddit", "type": "selector", "outbounds": ["🚀 默认代理", "🇺🇸 美国节点", "🇰🇷 韩国节点", "🕹️ 手动选择", "➡️ 直连"]},
    {"tag": "🎥 Netflix", "type": "selector", "outbounds": ["🚀 默认代理", "🇺🇸 美国节点", "🇰🇷 韩国节点", "🕹️ 手动选择", "➡️ 直连"]},
    {"tag": "🍎 Apple", "type": "selector", "outbounds": ["➡️ 直连", "🚀 默认代理"]},
    {"tag": "🐟 漏网之鱼", "type": "selector", "outbounds": ["🚀 默认代理", "➡️ 直连"]},
    {"tag": "➡️ 直连", "type": "direct"},
    {"tag": "🌐 全部节点", "type": "selector", "outbounds": ["{all}"], "filter": [{"action": "exclude", "keywords": ["TCP", "TLS"]}]}
  ],
  "route": {
    "default_http_client": "rule-set-direct",
    "rules": [
      {"action": "sniff", "sniffer": ["http", "tls", "quic", "dns"]},
      {"type": "logical", "mode": "or", "rules": [{"port": 53}, {"protocol": "dns"}], "action": "hijack-dns"},
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": "geosite-category-ads-all"},
          {"domain_regex": "^stun\\..+"},
          {"domain_keyword": ["stun", "httpdns"]},
          {"protocol": "stun"}
        ],
        "action": "reject"
      },
      {"ip_is_private": true, "outbound": "➡️ 直连"},
      {"domain_suffix": ["728966.xyz", "518989.xyz"], "outbound": "➡️ 直连"},
      {"rule_set": "geosite-ai", "outbound": "🧠 AI"},
      {"rule_set": "geosite-reddit", "outbound": "💬 Reddit"},
      {"rule_set": "geosite-apple", "outbound": "🍎 Apple"},
      {"rule_set": "geosite-netflix", "outbound": "🎥 Netflix"},
      {"rule_set": "geosite-!cn", "outbound": "🚀 默认代理"},
      {"rule_set": "geosite-cn", "outbound": "➡️ 直连"},
      {"rule_set": "geoip-apple", "outbound": "🍎 Apple"},
      {"rule_set": "geoip-netflix", "outbound": "🎥 Netflix"},
      {"rule_set": "geoip-cn", "outbound": "➡️ 直连"}
